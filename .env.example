# droplet-dynamic-pricing (Next.js) — example environment.
#
# Copy to .env and fill in real values. Never commit .env.
#
# The Rails app's own example lives in .env.local.example and is unchanged.
# Both apps read the same DATABASE_URL.

# ============================================================================
# REQUIRED
# ============================================================================

# The droplet's database. In production this is the SAME database the Rails app
# uses, and Rails owns its schema. The Prisma schema maps back onto the Rails
# tables and columns, and deliberately leaves five of them out (`settings`,
# `callbacks`, `users`, `webhooks`, `exigo_autoship_snapshots`) — so NEVER run
# `prisma db push` against it: that drops them. `pnpm db:push` refuses anything
# whose database name does not say dev/development/test/local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/droplet_dynamic_pricing_development

# Public URL of this droplet. Used to build the webhook and callback URLs sent
# to Fluid at registration, and — critically — to tell OUR callback
# registrations apart from those of other droplets installed for the same
# company. Locally this is your ngrok URL; in production the Cloud Run URL.
#
# Matched EXACTLY: a trailing slash or an http/https mismatch adopts nothing.
FLUID_DROPLET_URL=http://localhost:3000

# The droplet record's `webhook_secret` — what Fluid signs droplet.installed and
# droplet.uninstalled with. NOT the same value as FLUID_WEBHOOK_AUTH_TOKEN below
# (STU2-3356 compared them by hash). Unset, lifecycle events are verified
# against the auth token instead, and every install that reaches this app 401s.
FLUID_DROPLET_WEBHOOK_SECRET=

# The `auth_token` the Rails droplet registered its webhooks with — the same
# value as the Rails service's. Now only a fallback: per-company subscription
# webhooks are registered with each company's own webhook_verification_token.
FLUID_WEBHOOK_AUTH_TOKEN=

# ============================================================================
# OPTIONAL
# ============================================================================

# Base URL for outbound calls to the Fluid API. Defaults to
# https://api.fluid.app. Every call is made with the company's own `dit_`
# token from its install; there is no global api key.
# FLUID_API_URL=https://api.fluid.app

# This droplet's uuid, as issued by Fluid. Install events naming a different
# droplet are ignored. Unset, the guard is off and the log says so — which is
# safer than a WRONG value, since that silently ignores every install.
# DROPLET_UUID=

# The Rails service's origin, e.g. https://fluid-droplet-dynamic-pricing-….run.app.
# Uninstall uses it to delete the five Rails-host subscription webhooks of a
# company Rails installed; `pnpm backfill:callbacks` uses it to find the
# registrations Rails created. Unset, both skip the Rails side.
# LEGACY_RAILS_ORIGIN=

# Bearer token for the one ops route, PATCH /api/admin-api/company. Unset
# refuses every request.
# ADMIN_API_TOKEN=

# ============================================================================
# SCRIPTS ONLY — not read by the running app
# ============================================================================

# `pnpm cutover repoint` / `reconcile` only change anything with APPLY=1; without
# it they print the plan. See CUTOVER.md.
# APPLY=1

# ============================================================================
# PRICING — optional, tuning only
# ============================================================================

# How long one answer about a customer's standing subscriptions is reused, in
# seconds. Core fires one cart_item callback per LINE, so an N-line add asks
# the same question N times within a few seconds, each a round trip to Fluid or
# a fresh SQL connection to Exigo — all inside the 20-second budget the shopper
# is waiting on.
#
# Set to 0 to disable caching entirely; the guard is on the read as well as the
# write, so that takes effect immediately rather than only for new entries.
#
# NOTE this cache is per CONTAINER here, where Rails used Solid Cache in its own
# database. That is the safe direction — a cold container spends one extra
# lookup rather than reading a stale answer — but it does mean the hit rate is
# lower than the Rails app's.
# PREFERRED_LOOKUP_TTL_SECONDS=30

# ============================================================================
# EXIGO
# ============================================================================
#
# There are NO Exigo environment variables. Every credential is per company and
# lives in `integration_settings.credentials` — exigo_db_host, exigo_db_username,
# exigo_db_password, exigo_db_name, api_base_url, api_username, api_password.
#
# They are stored in PLAINTEXT jsonb, exactly as the Rails app left them.
# Encrypting them is a separate decision on a separate PR; nothing in this port
# widens that exposure, and no route here renders them.

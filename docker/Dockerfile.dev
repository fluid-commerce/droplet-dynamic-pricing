ARG RUBY_VERSION=3.4.2
FROM ruby:$RUBY_VERSION
ARG PNPM_VERSION=10.17.1

# Install dependencies
RUN apt-get update -qq
RUN apt-get install --no-install-recommends -y \
    npm \
    curl \
    nodejs \
    libpq-dev \
    freetds-dev \
    build-essential \
    postgresql-client && \
    npm install -g corepack && \
    corepack enable && \
    corepack prepare pnpm@$PNPM_VERSION --activate

WORKDIR /rails

# Copy everything over
COPY Gemfile Gemfile.lock ./

# Install Ruby/Rails dependencies
RUN gem install bundler:2.6.5 && \
bundle install

# Node install. vendor/droplet-sdk is a `link:` dependency, so it has to be
# present before pnpm can resolve the lockfile.
COPY package.json pnpm-lock.yaml ./
COPY vendor/droplet-sdk ./vendor/droplet-sdk
RUN pnpm install --frozen-lockfile

# Add binstubs to PATH
ENV PATH="/rails/bin:${PATH}"

# Expose port 3000 for the rails server and 5173 for the vite server
EXPOSE 3000 3036

CMD ["foreman", "start", "-f", "Procfile.dev"]
